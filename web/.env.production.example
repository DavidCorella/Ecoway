# Copia este archivo a .env.production (o fijala como variable de entorno
# en el hosting) antes de compilar. Sin esto el build falla a propósito
# (ver services/config.ts) en vez de apuntar a localhost por error.
#
# Mismo dominio con Caddy enrutando /api/* al backend (ver
# ApiRoutePrefixConvention): la URL va relativa, no el dominio completo.
NEXT_PUBLIC_API_URL=/api
